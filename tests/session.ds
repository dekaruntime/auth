import { echo } from "io"
import { from_string, to_base64, concat } from "bytes"
import { hmac, random_bytes, aes_256_gcm_encrypt } from "crypto"

import { auth, requireUser, requireRole, signIn, signOut } from "../index.ds"

fn req(cookie: string) {
  return { headers: Some({ cookie: Some(cookie) }) }
}

fn fail(msg: string) {
  echo(msg)
}

fn b64url(data: bytes) string {
  const raw = to_base64(data)
  return raw.replaceAll("+", "-").replaceAll("/", "_").replaceAll("=", "")
}

fn seal_plain(secret: bytes, name: string, json: string) string {
  const key = match (hmac("sha256", from_string("deka.auth.session.v1"), secret)) {
    Ok(k) => k,
    Err(e) => from_string("")
  }
  const nonce = match (random_bytes(12)) {
    Ok(n) => n,
    Err(e) => from_string("")
  }
  const ct = match (aes_256_gcm_encrypt(key, nonce, from_string(json), from_string(name))) {
    Ok(c) => c,
    Err(e) => from_string("")
  }
  return name + "=" + b64url(concat(nonce, ct))
}

fn go() {
  let secret = from_string("0123456789abcdef0123456789abcdef");
  let other = from_string("abcdef0123456789abcdef0123456789");

  const alice = match (signIn({ sub: "alice", roles: Some(["user"]) }, secret, {})) {
    Ok(out) => out,
    Err(e) => { cookie: "", value: "", header: "fail-signin" }
  };
  if (alice.header == "fail-signin" || alice.value == "") {
    fail("fail-signin");
    return;
  }
  if (alice.cookie != "deka_sid") {
    fail("fail-cookie-name");
    return;
  }

  if (!alice.header.includes("HttpOnly")) {
    fail("fail-httponly");
    return;
  }

  if (!alice.header.includes("Secure")) {
    fail("fail-secure-default");
    return;
  }

  const cookie = alice.cookie + "=" + alice.value;
  const authed = match (auth(req(cookie), secret)) {
    None => "none",
    Some(session) => session.sub
  };
  if (authed != "alice") {
    fail("fail-auth");
    echo(authed);
    return;
  }

  const missing = match (auth(req(""), secret)) {
    None => "none",
    Some(session) => session.sub
  };
  if (missing != "none") {
    fail("fail-missing");
    return;
  }

  const ga = match (auth(req("_ga=1; " + cookie + "; theme=dark"), secret)) {
    None => "none",
    Some(session) => session.sub
  };
  if (ga != "alice") {
    fail("fail-other-cookies");
    return;
  }

  const wrong = match (auth(req(cookie), other)) {
    None => "none",
    Some(session) => session.sub
  };
  if (wrong != "none") {
    fail("fail-wrong-secret");
    return;
  }

  const no_user = match (requireUser(req(""), secret)) {
    Ok(session) => "ok",
    Err(e) => e
  };
  if (no_user != "unauthenticated") {
    fail("fail-require-user");
    echo(no_user);
    return;
  }

  const as_user = match (requireRole(req(cookie), secret, "admin")) {
    Ok(session) => "ok",
    Err(e) => e
  };
  if (as_user != "unauthorized") {
    fail("fail-unauthorized");
    echo(as_user);
    return;
  }

  const admin = match (signIn({ sub: "bob", roles: Some(["admin", "user"]) }, secret, {})) {
    Ok(out) => out,
    Err(e) => { cookie: "", value: "", header: "" }
  };
  const admin_cookie = admin.cookie + "=" + admin.value;
  const as_admin = match (requireRole(req(admin_cookie), secret, "admin")) {
    Ok(session) => session.sub,
    Err(e) => e
  };
  if (as_admin != "bob") {
    fail("fail-admin");
    echo(as_admin);
    return;
  }

  const expired = match (signIn({ sub: "old" }, secret, { maxAge: Some(-10) })) {
    Ok(out) => out,
    Err(e) => { cookie: "", value: "", header: "" }
  };
  const expired_cookie = expired.cookie + "=" + expired.value;
  const expired_auth = match (auth(req(expired_cookie), secret)) {
    None => "none",
    Some(session) => session.sub
  };
  if (expired_auth != "none") {
    fail("fail-expired");
    return;
  }

  const v = alice.value;
  const i = 4;
  const ch = v.slice(i, i + 1);
  const repl = ch == "A" ? "B" : "A";
  const tail = v.slice(0, i) + repl + v.slice(i + 1, v.length);
  const tampered = match (auth(req("deka_sid=" + tail), secret)) {
    None => "none",
    Some(session) => session.sub
  };
  if (tampered != "none") {
    fail("fail-tamper");
    echo(tampered);
    return;
  }

  const custom = match (signIn({ sub: "carol" }, secret, { cookie: Some("sid") })) {
    Ok(out) => out,
    Err(e) => { cookie: "", value: "", header: "" }
  };
  const custom_ok = match (auth(req("sid=" + custom.value), secret, { cookie: Some("sid") })) {
    None => "none",
    Some(session) => session.sub
  };
  const custom_default = match (auth(req("sid=" + custom.value), secret)) {
    None => "none",
    Some(session) => session.sub
  };
  if (custom_ok != "carol" || custom_default != "none") {
    fail("fail-custom-cookie");
    return;
  }

  const insecure = match (signIn({ sub: "dave" }, secret, { secure: Some(false) })) {
    Ok(out) => out,
    Err(e) => { cookie: "", value: "", header: "" }
  };
  if (insecure.header == "" || insecure.header.includes("Secure")) {
    fail("fail-secure-opt-out");
    return;
  }

  const out = signOut({});
  if (!out.header.includes("Max-Age=0") || out.cookie != "deka_sid") {
    fail("fail-signout");
    return;
  }

  const missing_sub = match (signIn({ sub: "" }, secret, {})) {
    Ok(v) => "ok",
    Err(e) => e
  };
  if (missing_sub != "invalid session") {
    fail("fail-missing-sub");
    echo(missing_sub);
    return;
  }

  const short = match (signIn({ sub: "x" }, from_string("too-short"), {})) {
    Ok(v) => "ok",
    Err(e) => e
  };
  if (short != "secret must be at least 32 bytes") {
    fail("fail-short-secret");
    echo(short);
    return;
  }

  const cap = match (auth({ headers: Some({ Cookie: Some(cookie) }) }, secret)) {
    None => "none",
    Some(session) => session.sub
  };
  if (cap != "alice") {
    fail("fail-cookie-header");
    echo(cap);
    return;
  }

  const bad_json = match (auth(req(seal_plain(secret, "deka_sid", "not-json")), secret)) {
    None => "none",
    Some(session) => session.sub
  };
  if (bad_json != "none") {
    fail("fail-bad-json");
    return;
  }

  const parse_no_sub = match (auth(req(seal_plain(secret, "deka_sid", "{}")), secret)) {
    None => "none",
    Some(session) => session.sub
  };
  if (parse_no_sub != "none") {
    fail("fail-parse-missing-sub");
    return;
  }

  const garbage = match (auth(req("deka_sid=%%%%"), secret)) {
    None => "none",
    Some(session) => session.sub
  };
  if (garbage != "none") {
    fail("fail-bad-encoding");
    return;
  }

  echo("ok");
}

go()
