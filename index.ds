// Sealed session cookie for deka serve. Call inside the handler with the request.
// Default cookie name is deka_sid (same name island AAD binds). No locals.
import { random_bytes, hmac, aes_256_gcm_encrypt, aes_256_gcm_decrypt } from "crypto"
import { from_string, to_string, concat, to_base64, from_base64, len, slice, get, from_array } from "bytes"
import { value as cookie_value, build_set_cookie, clear_cookie } from "cookies"

interface AuthOptions {
  cookie: string?
  maxAge: number?
  secure: boolean?
}

interface AuthHeaders {
  cookie: string?
  Cookie: string?
}

interface AuthRequest {
  headers: AuthHeaders?
}

interface SessionUser {
  sub: string
  roles: Array<string>?
}

interface AuthCookie {
  cookie: string
  value: string
  header: string
}

interface SealedParts {
  nonce: bytes
  ciphertext: bytes
}

summon {
  total now_seconds(): number,
  stringify_session(user: SessionUser, now: number, maxAge: number): Exception<string, JsError>,
  parse_session_json(json: string, now: number): Exception<SessionUser, JsError>
} from "./boundary.mjs"

fn b64url_encode(data: bytes) string {
  const raw = to_base64(data)
  return raw.replaceAll("+", "-").replaceAll("/", "_").replaceAll("=", "")
}

fn b64url_decode(value: string) Exception<bytes, JsError> {
  return from_base64(value.replaceAll("-", "+").replaceAll("_", "/"))
}

fn nonce12(raw: bytes) bytes {
  let out = from_array([])
  let i = 0
  for (i = 0; i < 12; i = i + 1) {
    out = concat(out, from_array([get(raw, i)]))
  }
  return out
}

fn split_sealed(raw: bytes) Result<SealedParts, string> {
  if (len(raw) < 28) {
    return Err("unauthenticated")
  }
  return Ok({ nonce: nonce12(raw), ciphertext: slice(raw, 12) })
}

fn session_key(secret: bytes) {
  if (len(secret) < 32) {
    return Err("secret must be at least 32 bytes")
  }
  return hmac("sha256", from_string("deka.auth.session.v1"), secret)
}

fn opt_cookie(options: AuthOptions) string {
  const name = match (options.cookie) { Some(v) => v, None => "deka_sid" }
  if (name == "") {
    return "deka_sid"
  }
  return name
}

fn header_fields(headers: AuthHeaders) string {
  const lower = match (headers.cookie) { Some(v) => v, None => "" }
  if (lower != "") {
    return lower
  }
  return match (headers.Cookie) { Some(v) => v, None => "" }
}

fn cookie_header(request: AuthRequest) string {
  return match (request.headers) { None => "", Some(headers) => header_fields(headers) }
}

fn cookie_attrs(options: AuthOptions, empty: boolean) {
  const maxAge = empty ? 0 : match (options.maxAge) { Some(v) => v, None => 604800 }
  const secure = match (options.secure) { Some(v) => v, None => false }
  return { path: Some("/"), max_age: Some(maxAge), http_only: Some(true), same_site: Some("Lax"), secure: Some(secure) }
}

fn set_cookie(name: string, cookie_value: string, options: AuthOptions) {
  return build_set_cookie(name, cookie_value, cookie_attrs(options, cookie_value == ""))
}

fn session_json(user: SessionUser, options: AuthOptions) Exception<string, JsError> {
  const maxAge = match (options.maxAge) { Some(v) => v, None => 604800 }
  return stringify_session(user, now_seconds(), maxAge)
}

fn parse_session(pt: bytes) Exception<SessionUser, JsError> {
  return parse_session_json(to_string(pt), now_seconds())
}

fn role_in(roles: Array<string>, role: string) boolean {
  for (const r of roles) {
    if (r == role) {
      return true
    }
  }
  return false
}

fn has_role(session: SessionUser, role: string) boolean {
  return match (session.roles) { None => false, Some(roles) => role_in(roles, role) }
}

fn allow_role(session: SessionUser, role: string) Result<SessionUser, string> {
  if (has_role(session, role)) {
    return Ok(session)
  }
  return Err("unauthorized")
}

fn cookie_ok(name: string, value: string, options: AuthOptions) Result<AuthCookie, string> {
  return match (set_cookie(name, value, options)) {
    Err(e) => Err(e),
    Ok(header) => Ok({ cookie: name, value: value, header: header })
  }
}

fn read_session(request: AuthRequest, secret: bytes, options: AuthOptions) Result<SessionUser, string> {
  const name = opt_cookie(options);
  const value = cookie_value(cookie_header(request), name);
  if (value == "") {
    return Err("unauthenticated")
  }
  return match (session_key(secret)) {
    Err(e) => Err(e),
    Ok(key) => match (b64url_decode(value)) {
      Throw(e) => Err("unauthenticated"),
      Ok(raw) => match (split_sealed(raw)) {
        Err(e) => Err("unauthenticated"),
        Ok(parts) => match (aes_256_gcm_decrypt(key, parts.nonce, parts.ciphertext, from_string(name))) {
          Err(e) => Err("unauthenticated"),
          Ok(pt) => match (parse_session(pt)) {
            Throw(e) => Err("unauthenticated"),
            Ok(session) => Ok(session)
          }
        }
      }
    }
  }
}

export fn signIn(user: SessionUser, secret: bytes, options: AuthOptions = {}) Result<AuthCookie, string> {
  const name = opt_cookie(options);
  return match (session_json(user, options)) {
    Throw(e) => Err("invalid session"),
    Ok(json) => match (session_key(secret)) {
      Err(e) => Err(e),
      Ok(key) => match (random_bytes(12)) {
        Err(e) => Err(e),
        Ok(nonce) => match (aes_256_gcm_encrypt(key, nonce, from_string(json), from_string(name))) {
          Err(e) => Err(e),
          Ok(ct) => cookie_ok(name, b64url_encode(concat(nonce, ct)), options)
        }
      }
    }
  }
}

fn empty_out(name: string) AuthCookie {
  return { cookie: name, value: "", header: "" }
}

export fn signOut(options: AuthOptions = {}) AuthCookie {
  const name = opt_cookie(options);
  return match (clear_cookie(name, cookie_attrs(options, true))) {
    Err(e) => empty_out(name),
    Ok(header) => { cookie: name, value: "", header: header }
  }
}

export fn auth(request: AuthRequest, secret: bytes, options: AuthOptions = {}) Option<SessionUser> {
  // Option.None, not bare `None`: today `None` is JS null (#394). Callers
  // match Some/None on Option. After #394 do not "simplify" this to `None`
  // without checking the Option encoding — that reintroduces the bug in
  // the gap.
  return match (read_session(request, secret, options)) {
    Err(e) => Option.None,
    Ok(session) => Option.Some(session)
  }
}

fn cookie_err(e: string) Result<SessionUser, string> {
  if (e == "secret must be at least 32 bytes") {
    return Err(e)
  }
  return Err("unauthenticated")
}

export fn requireUser(request: AuthRequest, secret: bytes, options: AuthOptions = {}) Result<SessionUser, string> {
  return match (read_session(request, secret, options)) {
    Err(e) => cookie_err(e),
    Ok(session) => Ok(session)
  }
}

export fn requireRole(request: AuthRequest, secret: bytes, role: string, options: AuthOptions = {}) Result<SessionUser, string> {
  return match (requireUser(request, secret, options)) {
    Err(e) => Err(e),
    Ok(session) => allow_role(session, role)
  }
}
